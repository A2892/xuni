{
  "name": "vsid-student-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:vite",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:server": "node server.js",
    "migrate:cockroach-to-cockroach": "node scripts/migration/migrate-cockroach-to-cockroach.js",
    "migrate:data": "npm run migrate:cockroach-to-cockroach",
    "migrate:photos:replicas:dry": "node scripts/migration/replicate-photos-to-cloudinary-r2.mjs",
    "migrate:photos:replicas": "node scripts/migration/replicate-photos-to-cloudinary-r2.mjs --execute",
    "db:optimize-storage": "psql \"$COCKROACHDB_URL\" -f scripts/add_storage_management_optimizations.sql",
    "storage:cleanup-unreferenced:dry": "node scripts/cleanup-unreferenced-storage.mjs",
    "storage:cleanup-unreferenced": "node scripts/cleanup-unreferenced-storage.mjs --execute",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.89.0",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^14.1.0",
    "barcode": "^0.1.0",
    "bcryptjs": "^2.4.3",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.0",
    "mammoth": "^1.11.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.4.530",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "npm-run-all2": "^8.0.4",
    "pg": "^8.18.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
