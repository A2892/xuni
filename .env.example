# CockroachDB Configuration

# 新 CockroachDB（默认读写）
# 示例: postgresql://user:pass@host:26257/dbname?sslmode=verify-full
COCKROACHDB_URL=
VITE_COCKROACHDB_URL=

# 旧 CockroachDB（一次性迁移源）
COCKROACHDB_SOURCE_URL=

# 可选：自定义 CA 证书文件（通常不需要）
DB_SSL_ROOT_CERT=

# 可选：初始管理员（首次部署建议设置）
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=
ADMIN_SEED_ROLE=admin
ADMIN_SEED_STATUS=active
# bcrypt 轮数（8-14，默认 10）
ADMIN_PASSWORD_HASH_ROUNDS=10

# 可选：Cloudinary 前端直传（视频 <= 100MB 走 Cloudinary，>100MB 走 R2）
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=student-media
# 视频分流阈值（100MB）
VITE_VIDEO_CLOUDINARY_MAX_SIZE=104857600
# Cloudinary 单文件上限（建议与上面一致）
VITE_CLOUDINARY_MAX_FILE_SIZE=104857600
# 前端单文件总上限（5GB）
VITE_MAX_MEDIA_FILE_SIZE=5368709120

# Cloudinary 后端删除（用于回收站彻底删除时同步删除云端资源）
# 注意：以下密钥仅后端使用，不要放到前端代码里。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2（仅后端使用）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# 可选：如果配置了公开域名，建议填写；不填则回退为 endpoint/bucket/key
R2_PUBLIC_BASE_URL=
# 可选：预签名有效期（秒）
R2_SIGNED_URL_EXPIRES_SECONDS=900

# Cloudflare R2（大文件新桶；用于 >100MB 视频上传）
R2_NEW_ACCOUNT_ID=
R2_NEW_ACCESS_KEY_ID=
R2_NEW_SECRET_ACCESS_KEY=
R2_NEW_BUCKET=
R2_NEW_ENDPOINT=
R2_NEW_PUBLIC_BASE_URL=
# 通过前缀区分新旧对象（保持旧 R2 可读）
R2_NEW_OBJECT_KEY_PREFIX=r2v2
R2_NEW_SIGNED_URL_EXPIRES_SECONDS=900

# 后端单次上传上限（禁用分片时建议与前端一致）
MAX_UPLOAD_BYTES=5368709120
MAX_TOTAL_UPLOAD_BYTES=5368709120
API_UPLOAD_LIMIT=5gb
# true 表示禁用 /api/storage/:bucket/upload-chunk
STORAGE_DISABLE_CHUNK_UPLOAD=true
